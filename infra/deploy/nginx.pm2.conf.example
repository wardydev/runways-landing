# HTTP bootstrap: configure a TLS certificate and HTTPS redirect before go-live.
# PM2 serves only built files on loopback; do not proxy Astro dev/preview in production.
server {
  listen 80;
  server_name runways.sewaclaude.id;

  location / {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    # Pass through article redirects and genuine 404 responses, without SPA fallback.
    proxy_intercept_errors off;
  }
}
