{
  "name": "runways",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @runways/web",
    "build": "npm run build --workspace @runways/web",
    "preview": "npm run preview --workspace @runways/web",
    "dev:local": "node scripts/local-preview.mjs",
    "build:local": "node scripts/local-preview.mjs --build",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "check:build": "node scripts/check-build.mjs",
    "setup:local": "node scripts/setup-local.mjs"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
